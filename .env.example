# ============================================================
# elegoo-notify - variabili d'ambiente
# Copia questo file in `.env` (mai committarlo: è già in .gitignore)
#   cp .env.example .env
# ============================================================

# --- Telegram (OBBLIGATORIO per le notifiche) ---
# Bot riusato: @Home979bot (lo stesso di HA/MoneyFlow). Il servizio è
# SOLO mittente (sendMessage/sendPhoto): nessun conflitto col polling.
# Per un bot dedicato: vedi README § "Configurare Telegram".
TELEGRAM_TOKEN=inserisci_il_token_del_bot_qui
TELEGRAM_CHAT_ID=inserisci_il_tuo_chat_id

# Modalità dry-run: NON invia nulla a Telegram, registra i messaggi in
# data/logs/telegram_dryrun.jsonl (usata dai test di accettazione).
TELEGRAM_DRYRUN=0

# --- Sicurezza UI/API (opzionale) ---
# Se impostati, la dashboard e le API REST richiedono HTTP Basic Auth.
# Lascia vuoti per disattivare l'autenticazione (rete LAN fidata).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Generale (opzionale) ---
# Percorso alternativo del file di configurazione:
# ELEGOO_CONFIG=/app/config.json
# Livello di log (DEBUG, INFO, WARNING, ERROR):
# LOG_LEVEL=INFO
